# Copy to frontend/.env.
#
# Every variable here is NEXT_PUBLIC_*, which means Next.js inlines its value
# into the client bundle at build time rather than reading it at runtime. Two
# consequences worth knowing:
#   * Editing this file locally requires restarting `npm run dev`.
#   * In production the values are baked in when the Docker image is built, so
#     changing them on the Cloud Run service has no effect — see
#     frontend/Dockerfile.

# Backend API URL
# If using Nginx reverse proxy, keep /api
# Relative on purpose: the browser then calls the same origin it loaded the
# page from, and nginx routes /api/* to the backend. That keeps the session
# cookie first-party, which LIFF needs. Production overrides this at image
# build time with an absolute URL pointing at the api subdomain.
NEXT_PUBLIC_API=/api

# LINE LIFF ID
# From the LIFF app on your own LINE Login channel — the same app whose URL is
# LINE_LIFF_URL in backend/.env. Its endpoint URL must be your tunnel subdomain.
NEXT_PUBLIC_LINE_LIFF_ID=YOUR_LIFF_ID

# Public origin, used for canonical URLs, hreflang, sitemap and the OG card
# Only affects those absolute URLs, so local development can leave it as is.
# Note that the production build does not set it: it is not among the build
# arguments in frontend/Dockerfile, so production falls back to the
# DEFAULT_SITE_URL constant in lib/seo/site.ts, which holds the same value.
NEXT_PUBLIC_SITE_URL=https://synqer.club
