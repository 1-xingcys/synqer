# Copy to backend/.env and fill in.
#
# --- Ask the team for -------------------------------------------------------
#   * Your Cloudflare tunnel token. The tunnel and its ingress rules are
#     managed from the Cloudflare dashboard, so all you get locally is a token
#     and a subdomain. Point it at the nginx proxy and run both:
#         cloudflared tunnel run --token <token>
#         ./run-nginx.sh          (second terminal, from the repo root)
#   * Your subdomain added to the shared Google OAuth client's authorized
#     redirect URIs. Google rejects any redirect URI it has not been told
#     about, so Google login stays broken until someone adds yours.
#   * PROD_DATABASE_URL, but only if you need production data locally.
#
# --- Create yourself, in the LINE Developers Console ------------------------
#   Both channels are per-developer. Sharing one means your webhook and a
#   teammate's compete for the same bot's events.
#   * A LINE Login channel with a LIFF app, whose endpoint URL is your tunnel
#     subdomain. The channel supplies LINE_LOGIN_CHANNEL_ID and _SECRET; the
#     LIFF app supplies LINE_LIFF_URL here and NEXT_PUBLIC_LINE_LIFF_ID in
#     frontend/.env.
#   * A Messaging API channel for the bot, with "Use webhook" enabled and its
#     webhook URL set to https://YOUR_TUNNEL_HOST/api/line-bot/webhook
#
# Every redirect URI below has to use the same host as WEB_ORIGIN. The browser
# reaches the app through the tunnel, so that host is your tunnel subdomain,
# never localhost.

# Database
# Local development: run `npm run db:up` first to start the Postgres in docker-compose.yml
# Host port 5435 comes from that file; production points this at Neon instead.
DATABASE_URL=postgresql://synqer:synqer@localhost:5435/synqer_dev?schema=public

# Production connection string, used only by `npm run db:pull` to copy live data locally
PROD_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Server
# PORT is also the port nginx forwards /api/ to; changing it means changing
# the backend upstream in nginx.conf. WEB_ORIGIN is the single allowed CORS
# origin, which is the tunnel host rather than localhost:3000 because that is
# where the browser actually loads the app from.
NODE_ENV=development
PORT=8080
WEB_ORIGIN=https://YOUR_TUNNEL_HOST

# LINE Login
LINE_LOGIN_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
LINE_LOGIN_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET
LINE_LOGIN_REDIRECT_URI=https://YOUR_TUNNEL_HOST/api/auth/line/callback
LINE_LIFF_URL=https://liff.line.me/YOUR_LIFF_ID

# LINE BOT
# The secret verifies the signature on incoming webhooks; the access token
# authenticates outgoing calls (push messages, rich menu, group lookups).
LINE_BOT_CHANNEL_SECRET=YOUR_LINE_BOT_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN

# Google OAuth2
# Sign-in and calendar consent are separate flows with separate callbacks, so
# both URIs below have to be registered on the OAuth client.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_TUNNEL_HOST/api/auth/google/callback

# Google Calendar
GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR_TUNNEL_HOST/api/google-calendar/callback

# Session
# Signs the synqer.sid cookie. Any non-empty string works locally; changing it
# invalidates every existing session.
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Token encryption (field-level encryption for stored Google OAuth tokens)
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this makes already-stored Google tokens undecryptable, so affected
# users have to reconnect their calendar.
TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
