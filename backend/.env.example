# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# LINE Login
LINE_LOGIN_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
LINE_LOGIN_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET
LINE_LOGIN_REDIRECT_URI=https://YOUR_NGROK_HOST/api/auth/line/callback
LINE_LIFF_URL=https://liff.line.me/YOUR_LIFF_ID

# LINE BOT
LINE_BOT_CHANNEL_ID=YOUR_LINE_BOT_CHANNEL_ID
LINE_BOT_CHANNEL_SECRET=YOUR_LINE_BOT_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN

# Google OAuth2
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_NGROK_HOST/api/auth/google/callback

# Google Calendar
GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR_NGROK_HOST/api/google-calendar/callback

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Server
WEB_ORIGIN=https://YOUR_NGROK_HOST

# Session
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Token encryption (field-level encryption for stored Google OAuth tokens)
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
