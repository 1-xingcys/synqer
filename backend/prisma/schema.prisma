// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL points at the Postgres in backend/docker-compose.yml locally and
// at Neon in production, where it is set on the Cloud Run service in GCP.
// Schema changes are applied with `npx prisma migrate dev` locally; production
// is migrated by `prisma migrate deploy` in .github/workflows/deploy-to-gcp.yml.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  ONE_TIME
  RECURRING
}

enum EventSlotAxisType {
  DATE
  WEEKDAY
}

enum EventVoteMode {
  AVAILABLE
  UNAVAILABLE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String   @id @default(cuid())
  displayName  String?
  primaryEmail String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities               AuthIdentity[]
  votes                    EventVote[]
  stagedVotes              EventStagedVote[]
  lineGroupMemberships     LineGroupMember[]
  expectedParticipants     EventExpectedParticipant[]
  googleCalendarConnection GoogleCalendarConnection?
  ownedEvents              Event[]                    @relation("OwnedEvents")
}

model AuthIdentity {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  providerEmail  String?
  createdAt      DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

// Google Calendar connection
// Note: independent from the login OAuth; used to access the Google Calendar API
// One Google account can be linked by multiple Users (the same person may have both Google and LINE accounts)
model GoogleCalendarConnection {
  id              String   @id @default(cuid())
  userId          String
  googleAccountId String // Google account sub (unique identifier)
  googleEmail     String? // Google account email (for display)
  accessToken     String   @db.Text // Access Token
  refreshToken    String?  @db.Text // Refresh Token
  tokenExpiresAt  DateTime // Access Token expiration time
  scope           String // Granted scope
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Each User can link only one Google Calendar account
  // but the same Google account can be linked by different Users
  @@unique([userId])
  @@index([googleAccountId])
}

// LINE group
model LineGroup {
  id          String   @id @default(cuid())
  lineGroupId String   @unique // groupId provided by LINE
  groupName   String? // Group name (when the Bot can retrieve it)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  botJoinedAt DateTime @default(now()) // When the Bot joined
  isActive    Boolean  @default(true) // Whether the Bot is still in the group

  members LineGroupMember[]
  events  Event[]
}

// LINE group member (detected through events)
model LineGroupMember {
  id          String    @id @default(cuid())
  lineGroupId String
  lineUserId  String // userId from LINE
  displayName String? // Name retrieved via getProfile
  pictureUrl  String? // Avatar retrieved via getProfile
  isActive    Boolean   @default(true) // Whether still in the group
  firstSeenAt DateTime  @default(now()) // When first detected
  lastSeenAt  DateTime  @default(now()) // Last activity time
  leftAt      DateTime? // When the member left the group

  lineGroup LineGroup @relation(fields: [lineGroupId], references: [id], onDelete: Cascade)

  // Link to an OAuth'd user (optional)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([lineGroupId, lineUserId])
  @@index([lineGroupId])
  @@index([lineUserId])
}

// Represents a time-voting event
model Event {
  id          String  @id @default(cuid())
  title       String?
  description String?
  type        EventType @default(ONE_TIME)
  ownerId     String? // Event owner
  owner       User?   @relation("OwnedEvents", fields: [ownerId], references: [id], onDelete: SetNull)
  timeZone        String @default("Asia/Taipei")

  // Host-configured view default: display granularity of the time grid (15/30/60 minutes)
  // The underlying slot is still 15 minutes; this only affects how coarsely the frontend merges cells
  defaultGranularityMin Int           @default(30)
  // Host-configured view default: initial mode participants get when they open the vote
  defaultVoteMode       EventVoteMode @default(AVAILABLE)
  // Host-configured: whether committing a vote posts a notice into the chat the
  // participant voted from. Some hosts want the reminder, others find it spammy.
  shareVoteToChat       Boolean       @default(true)

  // Voting deadline
  votingDeadline DateTime?

  // LINE group association (optional)
  lineGroupId String?
  lineGroup   LineGroup? @relation(fields: [lineGroupId], references: [id], onDelete: SetNull)

  // Soft delete: marks whether the event has been deleted
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots                EventTimeSlot[]
  votes                EventVote[]
  stagedVotes          EventStagedVote[]
  expectedParticipants EventExpectedParticipant[]
  confirmedTimeSlots   ConfirmedEventTimeSlot[]
  stagedConfirmation   EventStagedConfirmation?
  oneTimeSchedule      OneTimeEventSchedule?
  recurringSchedule    RecurringEventSchedule?

  @@index([lineGroupId])
  @@index([ownerId])
  @@index([type])
}

// Participants expected to vote
model EventExpectedParticipant {
  id        String   @id @default(cuid())
  eventId   String
  createdAt DateTime @default(now())

  // Can be specified by LINE userId (not yet OAuth'd)
  lineUserId String?

  // Or by an already OAuth'd user
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Used to track reminder state
  reminderSentAt DateTime?
  hasVoted       Boolean   @default(false)

  // Soft delete: marks whether this participant has been removed
  isRemoved Boolean @default(false)

  @@unique([eventId, lineUserId])
  @@unique([eventId, userId])
  @@index([eventId])
}

// Expanded time slots
model EventTimeSlot {
  id          String            @id @default(cuid())
  eventId     String
  axisType    EventSlotAxisType @default(DATE)
  axisDate    DateTime?
  axisWeekday Weekday?
  startMinute Int // Start minute of the day
  endMinute   Int // End minute of the day
  index       Int // Used for ordering/positioning in the grid

  event          Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes          EventVote[]
  confirmedSlots ConfirmedEventTimeSlot[]

  @@index([eventId])
  @@index([eventId, index])
  @@index([eventId, axisType, axisDate])
  @@index([eventId, axisType, axisWeekday])
}

model OneTimeEventSchedule {
  id               String   @id @default(cuid())
  eventId          String   @unique
  startDate        DateTime
  endDate          DateTime
  startMinuteOfDay Int
  endMinuteOfDay   Int
  slotDurationMin  Int      @default(15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model RecurringEventSchedule {
  id               String    @id @default(cuid())
  eventId          String    @unique
  weekdays         Weekday[] @default([])
  startMinuteOfDay Int
  endMinuteOfDay   Int
  slotDurationMin  Int       @default(15)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Vote record: a record means available, no record means unavailable or not filled in
model EventVote {
  id        String   @id @default(cuid())
  eventId   String
  slotId    String
  userId    String
  createdAt DateTime @default(now())

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slot  EventTimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, slotId, userId])
  @@index([eventId])
  @@index([slotId])
  @@index([userId])
}

// Staged vote record: each user keeps a single draft per event
// slotIds stores the canonical available slots (an empty array means a draft exists with nothing available)
model EventStagedVote {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  slotIds         String[] @default([])
  baselineSlotIds String[] @default([]) // Baseline available slots when the draft was created; used to tell whether staged is back to its initial state
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Event time slots confirmed by the host
model ConfirmedEventTimeSlot {
  id        String   @id @default(cuid())
  eventId   String
  slotId    String
  createdAt DateTime @default(now())

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slot  EventTimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([eventId, slotId])
  @@index([eventId])
}

// Staged draft of the host's slot confirmation
model EventStagedConfirmation {
  id              String   @id @default(cuid())
  eventId         String   @unique
  slotIds         String[] @default([])
  baselineSlotIds String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// express-session persistence (see @quixo3/prisma-session-store)
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  // Expired-session cleanup filters on expiresAt; keeps it off a full scan
  @@index([expiresAt])
}
