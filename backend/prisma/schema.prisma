// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  ONE_TIME
  RECURRING
}

enum EventSlotAxisType {
  DATE
  WEEKDAY
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String   @id @default(cuid())
  displayName  String?
  primaryEmail String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities               AuthIdentity[]
  votes                    EventVote[]
  stagedVotes              EventStagedVote[]
  lineGroupMemberships     LineGroupMember[]
  expectedParticipants     EventExpectedParticipant[]
  googleCalendarConnection GoogleCalendarConnection?
  ownedEvents              Event[]                    @relation("OwnedEvents")
}

model AuthIdentity {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  providerEmail  String?
  createdAt      DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

// Google Calendar 連結
// 注意：這是獨立於登入 OAuth 的，用於存取 Google Calendar API
// 同一個 Google 帳號可以被多個 User 連結（因為同一個人可能有 Google + LINE 兩個帳號）
model GoogleCalendarConnection {
  id              String   @id @default(cuid())
  userId          String
  googleAccountId String // Google 帳號的 sub (unique identifier)
  googleEmail     String? // Google 帳號的 email（便於顯示）
  accessToken     String   @db.Text // Access Token
  refreshToken    String?  @db.Text // Refresh Token
  tokenExpiresAt  DateTime // Access Token 過期時間
  scope           String // 授權的 scope
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 每個 User 只能連結一個 Google Calendar 帳號
  // 但同一個 Google 帳號可以被不同的 User 連結
  @@unique([userId])
  @@index([googleAccountId])
}

// LINE 群組
model LineGroup {
  id          String   @id @default(cuid())
  lineGroupId String   @unique // LINE 提供的 groupId
  groupName   String? // 群組名稱（如果 Bot 能取得）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  botJoinedAt DateTime @default(now()) // Bot 加入時間
  isActive    Boolean  @default(true) // Bot 是否仍在群組中

  members LineGroupMember[]
  events  Event[]
}

// LINE 群組成員（透過事件偵測到的成員）
model LineGroupMember {
  id          String    @id @default(cuid())
  lineGroupId String
  lineUserId  String // LINE 的 userId
  displayName String? // 透過 getProfile 取得的名稱
  pictureUrl  String? // 透過 getProfile 取得的頭像
  isActive    Boolean   @default(true) // 是否仍在群組中
  firstSeenAt DateTime  @default(now()) // 首次偵測到的時間
  lastSeenAt  DateTime  @default(now()) // 最後活動時間
  leftAt      DateTime? // 離開群組的時間

  lineGroup LineGroup @relation(fields: [lineGroupId], references: [id], onDelete: Cascade)

  // 關聯到已 OAuth 的使用者（可選）
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([lineGroupId, lineUserId])
  @@index([lineGroupId])
  @@index([lineUserId])
}

// 代表一個時間投票活動
model Event {
  id          String  @id @default(cuid())
  title       String?
  description String?
  type        EventType @default(ONE_TIME)
  ownerId     String? // 活動擁有者
  owner       User?   @relation("OwnedEvents", fields: [ownerId], references: [id], onDelete: SetNull)

  // 投票日期範圍（可投票的日期選項）
  startDate DateTime
  endDate   DateTime

  // 每日可投票的時間範圍（以分鐘表示，例如 9:00 = 540）
  startMinuteOfDay Int
  endMinuteOfDay   Int

  slotDurationMin Int    @default(15) // 預留：未來可支援 30/60 分鐘
  timeZone        String @default("Asia/Taipei") // 預留：未來可自動轉換時區

  // 投票截止時間
  votingDeadline DateTime?

  // LINE 群組關聯（可選）
  lineGroupId String?
  lineGroup   LineGroup? @relation(fields: [lineGroupId], references: [id], onDelete: SetNull)

  // 軟刪除：標記活動是否已被刪除
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots                EventTimeSlot[]
  votes                EventVote[]
  stagedVotes          EventStagedVote[]
  expectedParticipants EventExpectedParticipant[]
  confirmedTimeSlots   ConfirmedEventTimeSlot[]
  stagedConfirmation   EventStagedConfirmation?
  oneTimeSchedule      OneTimeEventSchedule?
  recurringSchedule    RecurringEventSchedule?

  @@index([lineGroupId])
  @@index([ownerId])
  @@index([type])
}

// 預期應該投票的參與者
model EventExpectedParticipant {
  id        String   @id @default(cuid())
  eventId   String
  createdAt DateTime @default(now())

  // 可以透過 LINE userId 指定（尚未 OAuth）
  lineUserId String?

  // 或透過已 OAuth 的使用者指定
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // 用於追蹤提醒狀態
  reminderSentAt DateTime?
  hasVoted       Boolean   @default(false)

  // 軟刪除：標記此參與者是否已被移除
  isRemoved Boolean @default(false)

  @@unique([eventId, lineUserId])
  @@unique([eventId, userId])
  @@index([eventId])
}

// 時間格子（slot）已展開
model EventTimeSlot {
  id          String            @id @default(cuid())
  eventId     String
  date        DateTime // 該 slot 的日期
  axisType    EventSlotAxisType @default(DATE)
  axisDate    DateTime?
  axisWeekday Weekday?
  startMinute Int // 當天的起始分鐘
  endMinute   Int // 當天的結束分鐘
  index       Int // 用於表格排序定位

  event          Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes          EventVote[]
  confirmedSlots ConfirmedEventTimeSlot[]

  @@index([eventId])
  @@index([eventId, date])
  @@index([eventId, axisType, axisDate])
  @@index([eventId, axisType, axisWeekday])
}

model OneTimeEventSchedule {
  id               String   @id @default(cuid())
  eventId          String   @unique
  startDate        DateTime
  endDate          DateTime
  startMinuteOfDay Int
  endMinuteOfDay   Int
  slotDurationMin  Int      @default(15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model RecurringEventSchedule {
  id               String    @id @default(cuid())
  eventId          String    @unique
  weekdays         Weekday[] @default([])
  startMinuteOfDay Int
  endMinuteOfDay   Int
  slotDurationMin  Int       @default(15)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// 投票紀錄：有紀錄 = 有空，無紀錄 = 沒空或未填
model EventVote {
  id        String   @id @default(cuid())
  eventId   String
  slotId    String
  userId    String
  createdAt DateTime @default(now())

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slot  EventTimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, slotId, userId])
  @@index([eventId])
  @@index([slotId])
  @@index([userId])
}

// 暫存投票紀錄：每個使用者在每個活動只保留一份草稿
// slotIds 儲存 canonical available slots（可為空陣列，代表已建立草稿且全部沒空）
model EventStagedVote {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  slotIds         String[] @default([])
  baselineSlotIds String[] @default([]) // 草稿建立時的 baseline available slots，用於判斷 staged 是否回到初始狀態
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Host 確認的活動時段
model ConfirmedEventTimeSlot {
  id        String   @id @default(cuid())
  eventId   String
  slotId    String
  createdAt DateTime @default(now())

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slot  EventTimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([eventId, slotId])
  @@index([eventId])
}

// Host 確認時段的暫存草稿
model EventStagedConfirmation {
  id              String   @id @default(cuid())
  eventId         String   @unique
  slotIds         String[] @default([])
  baselineSlotIds String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
